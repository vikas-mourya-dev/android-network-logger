<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nl_background"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/nl_primary"
        android:elevation="4dp"
        app:titleTextColor="@android:color/white"
        app:navigationIconTint="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Overview -->
            <com.google.android.material.card.MaterialCardView
                style="@style/NetworkLogger.DetailCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/badge_method"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="GET" />

                        <TextView
                            android:id="@+id/badge_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="200" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/text_latency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/nl_text_secondary"
                            android:textSize="13sp"
                            tools:text="427ms" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/nl_text_primary"
                        android:textIsSelectable="true"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="https://jsonplaceholder.typicode.com/posts/1" />

                    <TextView
                        android:id="@+id/text_times"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/nl_text_secondary"
                        android:textSize="12sp"
                        tools:text="Requested: 2026-07-21 19:58:14.715\nResponded: 2026-07-21 19:58:15.250" />

                    <TextView
                        android:id="@+id/text_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/nl_status_error"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Error: Unable to resolve host" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Headers (collapsible) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/NetworkLogger.DetailCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout_headers_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Headers"
                            android:textColor="@color/nl_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/icon_headers_chevron"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Expand headers"
                            android:src="@drawable/ic_expand_more_24"
                            app:tint="@color/nl_text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_headers_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingBottom="14dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Request Headers"
                            android:textColor="@color/nl_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_request_headers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:textColor="@color/nl_text_primary"
                            android:textIsSelectable="true"
                            android:textSize="12sp"
                            tools:text="(none)" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Response Headers"
                            android:textColor="@color/nl_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_response_headers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:textColor="@color/nl_text_primary"
                            android:textIsSelectable="true"
                            android:textSize="12sp"
                            tools:text="(none)" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Request body -->
            <com.google.android.material.card.MaterialCardView
                style="@style/NetworkLogger.DetailCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Request"
                            android:textColor="@color/nl_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/button_request_format"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:padding="6dp"
                            android:text="Minify"
                            android:textColor="@color/nl_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/button_copy_request"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Copy request body"
                            android:padding="6dp"
                            android:src="@drawable/ic_content_copy_24"
                            app:tint="@color/nl_text_secondary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_request_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/nl_text_primary"
                        android:textIsSelectable="true"
                        android:textSize="12sp"
                        tools:text="(none)" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Response body -->
            <com.google.android.material.card.MaterialCardView
                style="@style/NetworkLogger.DetailCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Response"
                            android:textColor="@color/nl_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/button_response_format"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:padding="6dp"
                            android:text="Minify"
                            android:textColor="@color/nl_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/button_copy_response"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Copy response body"
                            android:padding="6dp"
                            android:src="@drawable/ic_content_copy_24"
                            app:tint="@color/nl_text_secondary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_response_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/nl_text_primary"
                        android:textIsSelectable="true"
                        android:textSize="12sp"
                        tools:text="(none)" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
